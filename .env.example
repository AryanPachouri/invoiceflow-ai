# ─────────────────────────────────────────────────────────────────────────────
# InvoiceFlow AI — environment configuration
# Every variable is optional. With nothing set, the app runs fully locally:
#   database → PGlite (embedded Postgres in ./.data/pglite)
#   storage  → local filesystem (./.data/uploads)
#   AI       → disabled (deterministic parser + Tesseract OCR)
# All variables are read on the SERVER only. None are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Supabase: Project Settings → Database → Connection string).
# Use the Session pooler (port 5432) or direct connection. Transactions + row locks are required,
# so do NOT use the Transaction pooler (port 6543).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
DATABASE_POOL_MAX=5

# Supabase Storage for original invoice PDFs (private bucket, created automatically if missing).
# SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_URL=
# Service-role key: server-side only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=invoices

# Optional Claude-assisted extraction for low-confidence / unusual layouts.
# Without a key the pipeline runs fully deterministically.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=30000

# Vendor email sending (Resend — https://resend.com). Server-side only.
# Without these, emails can still be drafted, edited, saved and copied, but "Send Email" is disabled.
# EMAIL_FROM must use a domain verified in your Resend account.
RESEND_API_KEY=
EMAIL_FROM=
# e.g. EMAIL_FROM="Accounts Payable <ap@yourcompany.com>"
EMAIL_REPLY_TO=
# Company name used in email sign-offs
COMPANY_NAME=Contoso Manufacturing Corp.

# Limits & timeouts
MAX_UPLOAD_MB=10
OCR_TIMEOUT_MS=90000
RUN_TIMEOUT_MS=180000

# Demo pacing: minimum visible time per stage in the live monitor (ms). Real stage durations are
# still measured and displayed exactly; set to 0 to disable.
PIPELINE_STAGE_DELAY_MS=400

# Seed vendors, POs and sample history automatically on first boot.
AUTO_SEED=true

# Local fallbacks (used only when DATABASE_URL / Supabase are not set)
# PGLITE_DATA_DIR=./.data/pglite
# LOCAL_STORAGE_DIR=./.data/uploads
